# Copy this file to .env and fill in your keys
# (PowerShell: copy .env.example .env)

# Required - every agent uses OpenAI (gpt-4o-mini, gpt-4o, text-embedding-3-small)
OPENAI_API_KEY=

# Optional - backup model, used by the LLM Gateway only if OpenAI fails
GROQ_API_KEY=

# Needed for "uv run main.py eval" (and to see traces at smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=it-triage-desk
